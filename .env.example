# Copy to .env and adjust
AGENT_MODEL=llama3.2:3b
AGENT_EMBED_MODEL=nomic-embed-text
OLLAMA_HOST=http://localhost:11434
AGENT_MAX_STEPS=6
AGENT_MAX_REVISIONS=1
AGENT_ACCEPT_SCORE=7
AGENT_ENABLE_PLANNER=true
AGENT_ENABLE_CRITIC=true
AGENT_ENABLE_MEMORY=true
AGENT_WORKSPACE=workspace
AGENT_TRACE_DIR=runs
